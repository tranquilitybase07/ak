---
import { site, socials } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = site.title, description = site.description, image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#person`,
      name: site.name,
      url: Astro.site?.href,
      email: `mailto:${site.email}`,
      image: new URL('/og.png', Astro.site).href,
      jobTitle: 'Frontend & Product Engineer',
      worksFor: { '@type': 'Organization', name: site.current.company },
      address: { '@type': 'PostalAddress', addressLocality: 'Ottawa', addressRegion: 'ON', addressCountry: 'CA' },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Lambton College' },
        { '@type': 'CollegeOrUniversity', name: 'Bhagwan Parshuram Institute of Technology' },
      ],
      knowsAbout: ['React', 'TypeScript', 'Angular', 'Design systems', 'Web performance', 'Accessibility', 'RAG'],
      sameAs: socials.map((s) => s.href),
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site?.href,
      name: site.name,
      publisher: { '@id': `${Astro.site}#person` },
      inLanguage: 'en',
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={site.name} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#0E3B27" />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
<meta property="profile:first_name" content="Ankush" />
<meta property="profile:last_name" content="Kumar" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
