---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Optional portrait for the right-hand card. Import it from src/assets and pass it in. */
  photo?: ImageMetadata;
}

const { photo } = Astro.props;
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="card text" data-reveal>
    <h2 id="about-title" class="mono eyebrow">ABOUT</h2>
    <p class="big">
      I'm happiest at the messy start of a product, when nobody's sure yet what it should be.
    </p>
    <p class="small">
      My day job is engineering at scale: shared components other teams build on, apps made up to 60% faster, 8 engineers
      mentored. My evenings are a studio of one. I pick a problem, design the thing, build it, launch it and work out how to
      charge for it. Doing every job in that loop is why I read a spec the way a founder would: what's it for, who's it for,
      and what can we cut?
    </p>
  </div>

  <div class="visual" data-reveal data-curve-host>
    {photo && <Image src={photo} alt="Ankush Kumar sitting on a hilltop at dusk, looking out over misty green hills" class="photo" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 520px" />}
    <div class="shade" aria-hidden="true"></div>
    <p class="tagline">From confusing to obvious.</p>
    <svg viewBox="0 0 400 300" preserveAspectRatio="none" class="curve" aria-hidden="true">
      <path
        data-curve
        d="M40 270 C 140 300, 170 240, 230 190 S 320 80, 360 40"
        fill="none"
        stroke="#93FA5B"
        stroke-width="9"
        stroke-linecap="round"
        pathLength="1"></path>
      <circle cx="40" cy="270" r="9" fill="#93FA5B"></circle>
      <path d="M336 36 L366 34 L356 62" fill="none" stroke="#93FA5B" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="label start" aria-hidden="true">Where users<br />start</span>
    <span class="label end" aria-hidden="true">Where they<br />just get it</span>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 64px;
  }
  .text {
    flex: 1.3 1 480px;
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .big {
    margin: 0;
    font-weight: 700;
    font-size: clamp(26px, 2.8vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  .small {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 600px;
    text-wrap: pretty;
  }
  .visual {
    flex: 1 1 400px;
    min-height: 440px;
    border-radius: var(--radius-card);
    overflow: hidden;
    position: relative;
    background: var(--forest);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 59, 39, 0.55), rgba(14, 59, 39, 0) 45%, rgba(14, 59, 39, 0.45));
    pointer-events: none;
  }
  .tagline {
    position: absolute;
    left: 28px;
    top: 24px;
    right: 28px;
    margin: 0;
    font-weight: 800;
    font-size: clamp(32px, 3.4vw, 44px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .curve {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 60%;
    pointer-events: none;
    overflow: visible;
  }
  .curve [data-curve] {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  :global(.js) .curve [data-curve] {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.6, 0.1, 0.2, 1);
  }
  :global(.js) .curve [data-curve].drawn {
    stroke-dashoffset: 0;
  }
  .label {
    position: absolute;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.1;
    color: #fff;
    pointer-events: none;
  }
  .start {
    left: 28px;
    bottom: 52px;
  }
  /* Sit just above the arrowhead. The curve SVG fills the bottom 60% and the
     arrowhead's top is at y=34 of its 300-unit viewBox: 60% * (266/300) ≈ 53.2%. */
  .end {
    right: 28px;
    bottom: calc(53.2% + 14px);
    text-align: right;
  }
</style>
