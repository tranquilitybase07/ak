---
import { education, experience, toolGroups } from '../data/content';
---

<section id="experience" class="exp" aria-labelledby="exp-title">
  <div class="card history" data-reveal>
    <h2 id="exp-title">Experience</h2>
    <ol class="list">
      {
        experience.map((e) => (
          <li class="row job">
            <div>
              <h3 class="role">{e.role}</h3>
              <p class="company">{e.company}</p>
              <p class="note">{e.note}</p>
            </div>
            <span class="mono years">{e.years}</span>
          </li>
        ))
      }
    </ol>
    <h3 class="mono eyebrow">EDUCATION</h3>
    <ol class="list">
      {
        education.map((e) => (
          <li class="row edu">
            <div>
              <p class="edu-title">{e.title}</p>
              <p class="school">{e.school}</p>
            </div>
            <span class="mono years">{e.years}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="card toolkit" data-reveal>
    <h2>Toolkit</h2>
    {
      toolGroups.map((g) => (
        <div class="group">
          <h3 class="mono group-label">{g.label}</h3>
          <ul class="tools">
            {g.items.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  p {
    margin: 0;
  }
  .exp {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 64px;
  }
  h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(34px, 3.6vw, 46px);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .history {
    flex: 1.5 1 520px;
    padding: clamp(24px, 3.4vw, 40px);
  }
  .history h2 {
    margin-bottom: 20px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    border-top: 1.5px solid var(--line);
  }
  .job {
    padding: 18px 16px;
    border-radius: 16px;
    transition:
      background 0.25s,
      padding 0.3s var(--ease-out);
  }
  .job:hover {
    background: var(--lime);
    padding-left: 26px;
  }
  .role {
    margin: 0;
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.02em;
  }
  .company {
    font-size: 15px;
    color: var(--ink-2);
    margin-top: 2px;
  }
  .note {
    font-size: 15px;
    line-height: 1.45;
    margin-top: 8px;
    max-width: 520px;
  }
  .years {
    font-size: 13px;
  }
  .eyebrow {
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    margin: 28px 0 6px;
    padding: 0 16px;
  }
  .edu {
    padding: 14px 16px;
  }
  .edu-title {
    font-weight: 700;
    font-size: 17px;
  }
  .school {
    font-size: 14px;
    color: var(--ink-2);
    margin-top: 2px;
  }
  .toolkit {
    flex: 1 1 340px;
    padding: clamp(24px, 3.4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .group-label {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tools li {
    font-weight: 700;
    font-size: 15px;
    background: var(--chip);
    border-radius: 12px;
    padding: 9px 13px;
    transition:
      transform 0.3s var(--spring),
      background 0.2s,
      color 0.2s;
    cursor: default;
  }
  .tools li:hover {
    transform: rotate(-4deg) translateY(-3px);
    background: var(--ink);
    color: var(--lime);
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .years {
      order: -1;
      color: var(--muted);
    }
  }
</style>
