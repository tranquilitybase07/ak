---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <span>© {year} {site.name}. Designed and built by me.</span>
  <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 8px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
</style>
