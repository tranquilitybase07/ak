---
import { Image } from 'astro:assets';
import type { Project } from '../data/content';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
---

<article class="project" data-reveal>
  <div class="cover" data-parallax style={`background:${p.brand}`}>
    {
      p.logo && (
        <Image
          src={p.logo}
          alt={`${p.name} logo`}
          width={320}
          class="logo"
          style={`width:${p.logoSize};mix-blend-mode:${p.blend}`}
        />
      )
    }
    <span class="mono kind">{p.kind}</span>
  </div>
  <div class="body">
    <div>
      <h3>{p.name}</h3>
      <p class="desc">{p.desc}</p>
    </div>
    <div class="foot">
      <ul class="stack" aria-label="Tech stack">
        {p.stack.map((t) => <li class="mono">{t}</li>)}
      </ul>
      <div class="links">
        {p.more.map((l) => <a href={l.href} target="_blank" rel="noopener" class="more">{l.label}</a>)}
        {
          p.live ? (
            <a href={p.live} target="_blank" rel="noopener" class="visit" aria-label={`Visit ${p.name}`}>
              Visit <span aria-hidden="true">↗</span>
            </a>
          ) : (
            p.soon && (
              <span class="soon">
                <span class="dot" aria-hidden="true" />
                {p.soon}
              </span>
            )
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .project {
    background: #fff;
    border-radius: var(--radius-card);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition:
      transform 0.35s var(--spring),
      box-shadow 0.35s;
  }
  .project:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -34px rgba(14, 59, 39, 0.45);
  }
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 26px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .logo {
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    transition: transform 0.5s var(--spring);
    pointer-events: none;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.18));
  }
  .kind {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 12px;
    background: #fff;
    border-radius: 8px;
    padding: 5px 9px;
    pointer-events: none;
  }
  .body {
    padding: 18px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h3 {
    margin: 0;
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.035em;
  }
  .desc {
    margin: 4px 0 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .stack li {
    font-size: 12px;
    background: var(--chip);
    border-radius: 8px;
    padding: 5px 9px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .more {
    font-weight: 700;
    font-size: 14px;
    padding: 9px 13px;
    border-radius: 12px;
    border: 1.5px solid var(--ink);
    transition: background 0.2s;
  }
  .more:hover {
    background: var(--chip);
  }
  .visit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--lime);
    color: var(--ink);
  }
  .soon .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    animation: pulse 2s infinite;
  }
  .visit:hover {
    background: var(--lime);
    color: var(--ink);
  }
</style>
