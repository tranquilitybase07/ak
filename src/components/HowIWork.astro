---
import { beliefs } from '../data/content';
---

<section class="how" data-reveal aria-labelledby="how-title">
  <div class="head">
    <h2 id="how-title">How I work</h2>
    <span class="mono hint" aria-hidden="true">hover a stripe</span>
  </div>
  <ol class="stripes" data-stripes>
    {
      beliefs.map((b, i) => (
        <li class:list={['stripe', { active: i === 0 }]} style={`--bg:${b.bg};--fg:${b.ink}`}>
          <button type="button" class="hit" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`belief-${b.n}`}>
            <span class="mono n">{b.n}</span>
            <span class="sr-only">{b.title}</span>
          </button>
          <div class="content" id={`belief-${b.n}`}>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .how {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 64px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 0 8px;
  }
  h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(34px, 3.6vw, 46px);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .hint {
    font-size: 12px;
    color: var(--muted);
  }
  .stripes {
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 340px;
    display: flex;
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .stripe {
    position: relative;
    flex: 1 1 0;
    min-width: 46px;
    background: var(--bg);
    color: var(--fg);
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    overflow: hidden;
    transition: flex 0.6s var(--ease-out);
  }
  .stripe.active {
    flex: 5 1 0;
  }
  .hit {
    all: unset;
    position: absolute;
    inset: 0;
    padding: 24px 18px;
    cursor: pointer;
    border-radius: 0;
    display: flex;
    align-items: flex-start;
  }
  .hit:focus-visible {
    outline: 3px solid var(--lime);
    outline-offset: -6px;
  }
  .n {
    font-size: 13px;
    font-weight: 500;
  }
  .content {
    margin-top: auto;
    min-width: 260px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.4s 0.15s,
      transform 0.5s 0.15s var(--ease-out);
    pointer-events: none;
  }
  .active .content {
    opacity: 1;
    transform: translateY(0);
  }
  h3 {
    margin: 0 0 10px;
    font-weight: 800;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    max-width: 340px;
  }

  /* Phones: stack the stripes vertically so the copy has room to breathe */
  @media (max-width: 640px) {
    .hint {
      display: none;
    }
    .stripes {
      flex-direction: column;
      min-height: 0;
    }
    .stripe {
      flex: none;
      min-height: 64px;
      transition: none;
    }
    .stripe.active {
      flex: none;
    }
    .content {
      min-width: 0;
      margin-top: 0;
      max-height: 0;
      transition: none;
    }
    .active .content {
      max-height: 400px;
      margin-top: 28px;
    }
  }
</style>
